generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum Language {
  c
  cpp
  py
  pypy
}

enum Visibility {
  public
  private
}

enum JudgeStatus {
  pending
  judging
  done
  failed
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  password     String
  role         Role           @default(user)
  isBanned     Boolean        @default(false)
  displayName  String
  avatar       String?
  bio          String?
  sessions     Session[]
  Problem      Problem[]
  Submission   Submission[]
  Run          Run[]
  Announcement Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Problem {
  id          Int           @id @default(autoincrement())
  title       String
  visibility  Visibility    @default(private)
  timeLimit   Int
  memoryLimit Int
  score       Int
  testcases   Int
  authorId    Int
  author      User          @relation(fields: [authorId], references: [id])
  Submission  Submission[]
  Run         Run[]

  testcaseVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("problems")
}

model Submission {
  id          Int           @id @default(autoincrement())
  code        String
  language    Language
  score       Int           @default(0)
  result      Json?         @default("[]")
  status      String?       @default("In queue")
  errorCode   String?
  error       String?
  problemId   Int
  userId      Int
  problem     Problem       @relation(fields: [problemId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  judgeStatus JudgeStatus @default(pending)
  priority    Int         @default(0)
  attempts    Int         @default(0)

  // Visible only to the submitter and admins. Set at creation for admin submitters.
  hidden Boolean @default(false)

  // The code is readable by anyone who can see the submission. Off until the
  // submitter or an admin turns it on.
  codePublic Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([judgeStatus, priority, id])
  // The viewer's latest submission and solved status per problem.
  @@index([userId, problemId, id])
  // Who solved a problem, and how many.
  @@index([problemId, userId])
  @@map("submissions")
}

// A run executes the user's code against their own input, without submitting
// (#67). Runs are a separate table so they can never touch scores, solved
// status, counts or history: nothing that reads submissions ever sees them.
// They are private scratch work, queued and claimed like submissions, and the
// website deletes them after limits.run.ttlMinutes.
model Run {
  id        Int      @id @default(autoincrement())
  // One run per user: a new run replaces the last one (as a new row, so the
  // judge can't write an old result into it). Nothing keeps run history.
  userId    Int      @unique
  problemId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language  Language
  code      String
  input     String

  judgeStatus JudgeStatus @default(pending)
  status      String?     @default("In queue")
  attempts    Int         @default(0)

  // How the program ended: OK, TLE, MLE or RE. Null for a compile error or
  // a judge failure, which set errorCode instead.
  verdict         String?
  exitCode        Int?
  exitSignal      Int?
  stdout          String?
  stdoutTruncated Boolean @default(false)
  stderr          String?
  stderrTruncated Boolean @default(false)
  time            Float?
  memory          Float?

  errorCode String?
  error     String?

  // The user's rate limit, a token bucket carried from run to run: what was
  // left after this run, and when. limits.run says how it refills.
  runTokens   Float
  runTokensAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The judge claims the oldest pending run.
  @@index([judgeStatus, id])
  // Expiry deletes everything older than the ttl.
  @@index([createdAt])
  @@map("runs")
}

model Announcement {
  id         Int        @id @default(autoincrement())
  title      String
  content    String
  visibility Visibility @default(private)
  authorId   Int
  author     User       @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}
